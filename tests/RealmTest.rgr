; SPDX-License-Identifier: MIT
; DomRealm, driven as a host drives it: plain DOM scripts, React 18 (its UMD
; builds, tests/react/), events, timers, fetch, links and forms.
;
;   realm_test <dir with tests/react>
Import "../src/DomRealm.rgr"

class RealmTest {
    def fails:int 0
    def passes:int 0
    def dir:string "."

    fn check:void (name:string ok:boolean) {
        if ok {
            passes = (passes + 1)
            print ("  PASS " + name)
        } {
            fails = (fails + 1)
            print ("  FAIL " + name)
        }
    }

    fn file:string (name:string) {
        def c@(optional):string (read_file dir name)
        if (null? c) {
            print ("cannot read " + dir + "/" + name)
            return ""
        }
        return (unwrap c)
    }

    fn realm:DomRealm (html:string) {
        def r (new DomRealm())
        r.start(html "https://example.com/app/" 800.0 600.0)
        return r
    }

    fn idOf:string (r:DomRealm sel:string) {
        return (r.eval(("String(document.querySelector(" + (DomRealm.quote(sel)) + ").__id)")))
    }

    fn click:void (r:DomRealm sel:string) {
        def id:string (this.idOf(r sel))
        r.input(("{\"type\":\"down\",\"target\":" + id + "}"))
        r.input(("{\"type\":\"up\",\"target\":" + id + "}"))
        r.tick(0.0)
    }

    fn text:string (r:DomRealm sel:string) {
        return (r.eval(("document.querySelector(" + (DomRealm.quote(sel)) + ").textContent")))
    }

    fn plainDom:void () {
        def r:DomRealm (this.realm("<html><head><title>T</title><script>var p = document.createElement('p'); p.id = 'x'; p.className = 'note'; p.textContent = 'made by a script'; document.body.appendChild(p); document.title = 'Changed';</script></head><body><h1>Hi</h1></body></html>"))
        r.runScripts()
        def snap:string (r.snapshot())
        this.check("script adds a paragraph" ((indexOf snap "<p id=\"x\" class=\"note\" data-rd=") >= 0))
        this.check("its text" ((indexOf snap ">made by a script</p>") >= 0))
        this.check("title" ((r.title()) == "Changed"))
        this.check("no change since the snapshot" ((r.changed()) == false))
        r.eval("document.querySelector('h1').setAttribute('data-x', '1')")
        this.check("an attribute change is a change" (r.changed()))
        ; (the class list keeps its tokens per attribute value, attribute names their lower case)
        this.check("classList and attribute names after changes from both sides" ((r.eval("(function(){ var e=document.createElement('div'); var c=e.classList; var o=[]; c.add('a','b'); o.push(e.className); e.className='x  y z'; o.push(c.length, c.contains('y')); c.toggle('y'); o.push(e.className); c.toggle('q', true); c.toggle('q', true); o.push(e.className); e.setAttribute('class','m'); c.remove('m'); o.push(e.getAttribute('class')); e.removeAttribute('class'); c.add(); o.push(e.getAttribute('class')); c.add('k'); var l=[]; c.forEach(function(t){l.push(t)}); o.push(l.join()); e.setAttribute('DATA-X','1'); o.push(e.getAttribute('data-x'), e.getAttribute('Data-X')); try { c.add('a b'); o.push('no'); } catch (x) { o.push(x.name); } try { e.setAttribute('a b', 1); o.push('no'); } catch (x) { o.push(x.name); } var s=document.createElementNS('http://www.w3.org/2000/svg','svg'); s.setAttribute('viewBox','0 0 1 1'); o.push(s.getAttribute('viewBox'), s.getAttribute('viewbox')); return o.join('|'); })()")) == "a b|3|true|x z|x z q|||k|1|1|InvalidCharacterError|InvalidCharacterError|0 0 1 1|"))
    }

    fn react:void () {
        def html:string "<html><head><script src=\"react.js\"></script><script src=\"react-dom.js\"></script></head><body><div id=\"root\"></div><script src=\"app.js\"></script></body></html>"
        def r (new DomRealm())
        r.addScript("https://example.com/app/react.js" (this.file("tests/react/react.production.min.js")))
        r.addScript("https://example.com/app/react-dom.js" (this.file("tests/react/react-dom.production.min.js")))
        def app:string ""
        app = (app + "var h = React.createElement;\n")
        app = (app + "function App() {\n")
        app = (app + "  var c = React.useState(0), t = React.useState(''), d = React.useState('none'), e = React.useState('no');\n")
        app = (app + "  React.useEffect(function () { e[1]('yes'); fetch('/data.json').then(function (r) { return r.json(); }).then(function (j) { d[1](j.name); }); }, []);\n")
        app = (app + "  return h('div', { className: 'app' },\n")
        app = (app + "    h('button', { id: 'inc', onClick: function () { c[1](function (n) { return n + 1; }); } }, 'Count ' + c[0]),\n")
        app = (app + "    h('input', { id: 'name', value: t[0], onChange: function (ev) { t[1](ev.target.value.toUpperCase()); } }),\n")
        app = (app + "    h('p', { id: 'out' }, 'Hello ' + t[0]),\n")
        app = (app + "    h('p', { id: 'data' }, d[0]),\n")
        app = (app + "    h('span', { id: 'effect' }, e[0]),\n")
        app = (app + "    h('a', { id: 'spa', href: '/next', onClick: function (ev) { ev.preventDefault(); c[1](100); } }, 'in-app link'),\n")
        app = (app + "    h('a', { id: 'out-link', href: '/other' }, 'a real link'),\n")
        app = (app + "    c[0] > 1 ? h('span', { id: 'many' }, 'many') : null);\n")
        app = (app + "}\n")
        app = (app + "ReactDOM.createRoot(document.getElementById('root')).render(h(App));\n")
        r.addScript("https://example.com/app/app.js" app)
        r.start(html "https://example.com/app/" 800.0 600.0)
        r.runScripts()
        this.check("react: scripts ran" ((r.summary()) == "scripts=3 failed=0 errors=0"))
        if ((r.summary()) != "scripts=3 failed=0 errors=0") {
            print ("    " + (r.summary()))
            for r.errors e:string i {
                print ("    " + e)
            }
        }
        this.check("react: rendered" ((this.text(r "#inc")) == "Count 0"))
        this.check("react: effect ran" ((this.text(r "#effect")) == "yes"))
        ; the effect's fetch is a message to the host, answered later
        def msgs:string (r.messages())
        this.check("react: fetch asked of the host" ((indexOf msgs "\"tag\":\"fetch\",\"id\":1,\"url\":\"https://example.com/data.json\"") >= 0))
        r.resource(1 200 "{\"name\":\"from the host\"}" "application/json")
        r.tick(0.0)
        this.check("react: fetched data shown" ((this.text(r "#data")) == "from the host"))
        this.click(r "#inc")
        this.check("react: click updates state" ((this.text(r "#inc")) == "Count 1"))
        this.click(r "#inc")
        this.check("react: conditional element" ((indexOf (r.snapshot()) "id=\"many\"") >= 0))
        def nid:string (this.idOf(r "#name"))
        r.input(("{\"type\":\"set\",\"target\":" + nid + ",\"value\":\"ada\"}"))
        r.tick(0.0)
        this.check("react: controlled input" ((this.text(r "#out")) == "Hello ADA"))
        this.check("react: the field's value in the snapshot" ((indexOf (r.snapshot()) "value=\"ADA\"") >= 0))
        r.messages()
        this.click(r "#spa")
        this.check("react: preventDefault keeps a link in the app" (((this.text(r "#inc")) == "Count 100") && ((indexOf (r.messages()) "\"open\"") < 0)))
        this.click(r "#out-link")
        this.check("react: a link opens its URL" ((indexOf (r.messages()) "{\"tag\":\"open\",\"url\":\"https://example.com/other\",\"target\":\"_self\"}") >= 0))
    }

    fn timers:void () {
        def r:DomRealm (this.realm("<html><body><p id=t>0</p><script>var n = 0; setTimeout(function () { document.getElementById('t').textContent = 'later'; }, 100); setInterval(function () { n++; }, 30);</script></body></html>"))
        r.runScripts()
        this.check("timer: not yet" ((this.text(r "#t")) == "0"))
        this.check("timer: due in 30 ms" ((r.dueIn()) == 30.0))
        r.tick(60.0)
        this.check("timer: interval twice" ((r.eval("String(n)")) == "2"))
        r.tick(50.0)
        this.check("timer: fired" ((this.text(r "#t")) == "later"))
    }

    fn form:void () {
        def r:DomRealm (this.realm("<html><body><form action=\"/search\"><input name=q value=\"kissa koira\"><input type=checkbox name=all checked><button id=go>Hae</button></form></body></html>"))
        r.runScripts()
        this.click(r "#go")
        this.check("form: a GET form opens its query" ((indexOf (r.messages()) "\"url\":\"https://example.com/search?q=kissa%20koira&all=on\"") >= 0))
    }

    fn errors:void () {
        def r:DomRealm (this.realm("<html><body><script>null.x</script><script>document.body.setAttribute('data-ok', 'yes')</script></body></html>"))
        r.runScripts()
        this.check("errors: a failing script does not stop the next" ((indexOf (r.snapshot()) "data-ok=\"yes\"") >= 0))
        this.check("errors: counted" ((r.summary()) == "scripts=1 failed=1 errors=1"))
    }

    fn parser:void () {
        def r:DomRealm (this.realm("<html><body><div id=c></div></body></html>"))
        r.runScripts()
        def got (r.eval("var t = document.createElement('template'); t.innerHTML = '<p><?lit$1$>a<!x>b</ y><!-->c</p>'; var o = []; for (var n = t.content.firstChild.firstChild; n; n = n.nextSibling) o.push(n.nodeType + ':' + (n.data || '')); o.join(',')"))
        this.check("parser: bogus comments (<? <! </ ) and <!-->, as Lit's markers need" (got == "8:?lit$1$,3:a,8:x,3:b,8: y,8:,3:c"))
    }

    fn shadow:void () {
        def r:DomRealm (this.realm("<html><body><div id=h><span id=s>light</span><i slot=n id=n>named</i></div></body></html>"))
        r.runScripts()
        def got (r.eval("var h = document.getElementById('h'); var sr = h.attachShadow({ mode: 'open' }); sr.innerHTML = '<style>:host{color:rgb(0,0,200)}::slotted(span){font-weight:700}</style><p id=p><slot name=n></slot>|<slot></slot></p><button id=b>x</button>'; var log = []; h.addEventListener('click', function (e) { log.push(e.target.id); }); sr.getElementById('b').click(); var p = sr.getElementById('p'); [getComputedStyle(p).color, getComputedStyle(document.getElementById('s')).fontWeight, sr.querySelector('slot:not([name])').assignedNodes().map(function (x) { return x.id; }).join(), p.isConnected, document.querySelector('#p') === null, log.join()].join(';')"))
        this.check("shadow: :host, ::slotted, slots, isConnected, retargeted click" (got == "rgb(0, 0, 200);700;s;true;true;h"))
        def snap (r.eval("__render()"))
        this.check("shadow: the host renders its shadow tree, a slot what it takes" (((indexOf snap "\"x\":\"named\"") >= 0) && ((indexOf snap "\"x\":\"x\"") >= 0)))
    }

    ; a box whose own size, paint or display changed: its children are
    ; styled again and those that come out alike keep what is under them
    ; (kidsKept). After each change the page the kept styles give is the
    ; page with every style found again (__styleCheck).
    fn keptStyles:void () {
        def r:DomRealm (this.realm("<html><head><style>#app{width:400px;display:grid;grid-template-columns:1fr 1fr;background-color:rgb(1,2,3)}#app.flex{display:flex}#app.flex .card{width:90px}.card{display:flex;padding:2px}.w{width:inherit}.bg{background-color:inherit}.card b{color:red}#app.flex i{font-style:normal}</style></head><body><div id=app><div class=card><b>a</b><span class=w><i class=w>x</i></span></div><div class=\"card bg\"><p class=bg>y</p><i>z</i></div><div class=w><u class=w>q</u></div></div></body></html>"))
        def got (r.eval("var a = document.getElementById('app'), o = []; __render(); a.style.width = '300px'; __render(); o.push(__styleCheck() === ''); __render(); a.className = 'flex'; __render(); o.push(__styleCheck() === ''); __render(); a.style.backgroundColor = 'rgb(9,9,9)'; __render(); o.push(__styleCheck() === ''); __render(); a.className = ''; a.style.padding = '3px'; __render(); o.push(__styleCheck() === ''); o.push(getComputedStyle(document.querySelector('u')).width, getComputedStyle(document.querySelector('p')).backgroundColor); o.join()"))
        this.check("kept styles: a box's own change leaves the page as styled anew" (got == "true,true,true,true,300px,rgb(9, 9, 9)"))
    }
    ; one constructed sheet adopted by two shadow roots styles both, each
    ; by its own host (the roots share the sheet's rule index), and
    ; 'adoptedStyleSheets' is in Document.prototype (Lit asks, and gives
    ; every root a <style> of its own otherwise)
    fn adopted:void () {
        def r:DomRealm (this.realm("<html><body><div id=a></div><div id=b class=k></div></body></html>"))
        r.runScripts()
        def got (r.eval("var sh = new CSSStyleSheet(); sh.replaceSync(':host{color:rgb(1,1,1)}:host(.k){color:rgb(2,2,2)}p{margin-left:7px}'); var o = [('adoptedStyleSheets' in Document.prototype)]; ['a', 'b'].forEach(function (id) { var h = document.getElementById(id), sr = h.attachShadow({ mode: 'open' }); sr.innerHTML = '<p>x</p>'; sr.adoptedStyleSheets = [sh]; }); __render(); ['a', 'b'].forEach(function (id) { var p = document.getElementById(id).shadowRoot.querySelector('p'); o.push(getComputedStyle(p).color, getComputedStyle(p).marginLeft); }); document.adoptedStyleSheets = [sh]; o.push(document.adoptedStyleSheets.length); o.join(';')"))
        this.check("adopted sheets: one sheet in two shadow roots, each styled by its own host" (got == "true;rgb(1, 1, 1);7px;rgb(2, 2, 2);7px;1"))
    }
    ; a page whose content is in a declarative shadow root (a Podium
    ; layout, tori.fi): the parser attaches it, a sheet the host gives by
    ; URL styles the shadow tree its <link> is in and not the document, a
    ; <style>'s @import brings the host's sheet into the tree, and
    ; the page shows it
    fn declarativeShadowPage:void () {
        def r:DomRealm (this.realm("<html><head></head><body><x-layout id=h><template shadowrootmode=open><link rel=stylesheet href=/s.css><style>@import url('/i.css');</style><div id=app><p id=p class=k>p</p><i id=q class=m>q</i></div></template></x-layout><p id=out class=k>o</p></body></html>"))
        r.addStyle(".k{color:rgb(1,2,3)}" "https://example.com/s.css")
        r.addStyle(".m{margin-left:4px}" "https://example.com/i.css")
        def got (r.eval("var sr = document.getElementById('h').shadowRoot, o = [!!sr, document.querySelector('template') === null]; __render(); var a = sr.getElementById('app'); o.push(getComputedStyle(a).display, getComputedStyle(sr.getElementById('p')).color, getComputedStyle(sr.getElementById('q')).marginLeft, getComputedStyle(document.getElementById('out')).color); o.join(';')"))
        this.check("declarative shadow page: attached by the parser, its <link> and @import sheets scoped to it" (got == "true;true;block;rgb(1, 2, 3);4px;rgb(0, 0, 0)"))
    }
    ; :has() above a selector's subject: a class set under the box, an
    ; element put in and taken out, each styles what is under the box
    ; again (hasAbove), and the page is as when every style is found again
    fn hasAboveSubject:void () {
        def r:DomRealm (this.realm("<html><head><style>.box:has(.on) .z{color:rgb(1,2,3)}.box:has(> b) .z{margin-left:5px}.z{color:rgb(9,9,9)}</style></head><body><div class=box id=x><i id=t>t</i><p><span class=z id=z>z</span></p></div><div id=other><span class=z id=o>o</span></div></body></html>"))
        r.runScripts()
        def got (r.eval("var z = document.getElementById('z'), t = document.getElementById('t'), x = document.getElementById('x'), o = []; var c = function () { __render(); o.push(getComputedStyle(z).color + '/' + getComputedStyle(z).marginLeft + '/' + (__styleCheck() === '')); }; c(); t.className = 'on'; c(); t.className = ''; c(); var b = document.createElement('b'); x.appendChild(b); c(); x.removeChild(b); c(); o.push(getComputedStyle(document.getElementById('o')).color); o.join(';')"))
        this.check(":has() above the subject: a change under the box styles what is under it again" (got == "rgb(9, 9, 9)/0px/true;rgb(1, 2, 3)/0px/true;rgb(9, 9, 9)/0px/true;rgb(9, 9, 9)/5px/true;rgb(9, 9, 9)/0px/true;rgb(9, 9, 9)"))
    }
    fn hasSibling:void () {
        def r:DomRealm (this.realm("<html><head><style>.st:has(~ .on) .ln{color:rgb(1,2,3)}.st:has(+ .nx){margin-left:5px}.ln{color:rgb(9,9,9)}</style></head><body><div id=w><div class=st id=a><span class=ln id=l>l</span></div><div class=st id=b><span id=in>x</span></div><div class=st id=c>c</div></div></body></html>"))
        r.runScripts()
        def got (r.eval("var l = document.getElementById('l'), a = document.getElementById('a'), b = document.getElementById('b'), c = document.getElementById('c'), w = document.getElementById('w'), o = []; var k = function () { __render(); o.push(getComputedStyle(l).color + '/' + getComputedStyle(a).marginLeft + '/' + (__styleCheck() === '')); }; k(); c.className = 'st on'; k(); c.className = 'st'; k(); b.className = 'st nx'; k(); w.removeChild(b); k(); var d = document.createElement('div'); d.className = 'on'; w.appendChild(d); k(); o.join(';')"))
        this.check(":has(~ x) and :has(+ x): a sibling's change styles the parent's subtree again" (got == "rgb(9, 9, 9)/0px/true;rgb(1, 2, 3)/0px/true;rgb(9, 9, 9)/0px/true;rgb(9, 9, 9)/5px/true;rgb(9, 9, 9)/0px/true;rgb(1, 2, 3)/0px/true"))
    }
    fn styleElement:void () {
        def r:DomRealm (this.realm("<html><head></head><body><p id=p>p</p></body></html>"))
        r.runScripts()
        def got (r.eval("var p = document.getElementById('p'), o = [], k = function () { __render(); o.push(getComputedStyle(p).color + '/' + (__styleCheck() === '')); }; k(); var s = document.createElement('style'); document.head.appendChild(s); k(); s.textContent = 'p{color:rgb(1,2,3)}'; k(); s.textContent = 'p{color:rgb(1,2,3)}'; k(); s.textContent = ''; k(); s.appendChild(document.createTextNode('p{color:rgb(4,5,6)}')); k(); document.head.removeChild(s); k(); document.head.appendChild(s); k(); o.join(';')"))
        this.check("a <style> put in empty, given its text, emptied, taken out and put back" (got == "rgb(0, 0, 0)/true;rgb(0, 0, 0)/true;rgb(1, 2, 3)/true;rgb(1, 2, 3)/true;rgb(0, 0, 0)/true;rgb(4, 5, 6)/true;rgb(0, 0, 0)/true;rgb(4, 5, 6)/true"))
    }
    ; a <style> whose rules can match only some elements styles only them
    ; again (styleSheetChanged), an inherited change goes down by the kept
    ; rules (inheritDown), a :has() restyles only the ancestors it can be
    ; on, an escaped ':' in a class name is no pseudo-class: each step as
    ; the page styled anew (__styleCheck)
    fn scopedStyles:void () {
        def r:DomRealm (this.realm("<html><head><style>.u{padding-left:var(--gap,1px)}.\\[\\&_tr\\:last-child\\]\\:c tr:last-child{color:rgb(7,7,7)}.hx:has(>b){padding-top:5px}</style></head><body><div id=app><p class=u id=u>u</p><table class='[&_tr:last-child]:c'><tbody id=tb><tr><td>1</td></tr></tbody></table><div class=hx id=hx><i>i</i></div><span class=lock-x id=lx>x</span></div></body></html>"))
        r.runScripts()
        def got (r.eval("var o = [], b = document.body, $ = function (i) { return document.getElementById(i); }, cs = function (i, p) { return getComputedStyle($(i)).getPropertyValue(p); }, k = function () { __render(); o.push(__styleCheck() === ''); }; k(); var s = document.createElement('style'); s.textContent = 'body[data-lock]{overflow:hidden;--gap:4px}.lock-x{color:rgb(2,2,2)}[data-v]::-webkit-scrollbar{display:none}'; document.head.appendChild(s); k(); o.push(cs('lx', 'color'), cs('u', 'padding-left')); b.setAttribute('data-lock', ''); k(); o.push(cs('u', 'padding-left')); b.style.pointerEvents = 'none'; k(); o.push(cs('lx', 'pointer-events')); b.style.pointerEvents = ''; b.removeAttribute('data-lock'); k(); o.push(cs('lx', 'pointer-events'), cs('u', 'padding-left')); var tr = document.createElement('tr'); tr.id = 'tr2'; tr.innerHTML = '<td>2</td>'; $('tb').appendChild(tr); k(); o.push(cs('tr2', 'color'), $('tb').firstChild.style.color === '' && getComputedStyle($('tb').firstChild).color); $('hx').appendChild(document.createElement('b')); k(); o.push(cs('hx', 'padding-top')); document.head.removeChild(s); k(); o.push(cs('lx', 'color')); document.documentElement.style.color = 'rgb(3,3,3)'; k(); o.push(cs('u', 'color')); o.join()"))
        this.check(("a <style> for some elements, an inherited change, :has() ancestors, an escaped class name (" + got + ")") (got == "true,true,rgb(2, 2, 2),1px,true,4px,true,none,true,auto,1px,true,rgb(7, 7, 7),rgb(0, 0, 0),true,5px,true,rgb(0, 0, 0),true,rgb(3, 3, 3)"))
    }
    fn detachedImage:void () {
        def r:DomRealm (this.realm("<html><body><p>i</p></body></html>"))
        r.runScripts()
        r.eval("window.__img = []; var svg = 'data:image/svg+xml,' + encodeURIComponent('<svg xmlns=\\'http://www.w3.org/2000/svg\\' width=\\'64\\' height=\\'48\\'/>'); var i = new Image(); i.onload = function () { __img.push('load', i.complete, i.naturalWidth, i.naturalHeight); }; i.src = svg; __img.push(i.complete); var v = new Image(); v.src = 'data:image/svg+xml,' + encodeURIComponent('<svg xmlns=\\'http://www.w3.org/2000/svg\\' viewBox=\\'0 0 20 10\\'/>'); __img.push(v.naturalWidth, v.naturalHeight)")
        r.tick(0.0)
        def got (r.eval("__img.join()"))
        this.check(("an image out of the page loads, with its picture's own size (" + got + ")") (got == "false,20,10,load,true,64,48"))
    }
    fn movedRender:void () {
        def r:DomRealm (this.realm("<html><head><style>.b{position:absolute;width:40px;height:30px}.red{color:rgb(9,0,0)}</style></head><body><div id=w><div class=b id=a style='transform:translate(1px,2px)'>a</div><div class=b id=b style='transform:rotate(3deg);opacity:0.5'><span id=in>in</span>t</div></div></body></html>"))
        r.runScripts()
        def got (r.eval("__deltaRender(true); __renderDelta(); __fastRenderCheck(true); var a = document.getElementById('a'), b = document.getElementById('b'), sp = document.getElementById('in'), o = []; for (var i = 0; i < 4; i++) { a.style.transform = 'translate(' + i + 'px, 2px) rotate(' + i + 'deg)'; b.style.transform = 'rotate(' + (i + 4) + 'deg)'; __renderDelta(); } o.push(JSON.parse(__fastRenderCheck()).n); for (i = 0; i < 3; i++) { b.style.opacity = String(0.4 + i / 10); __renderDelta(); } o.push(JSON.parse(__fastRenderCheck()).n); sp.className = 'red'; b.style.transform = 'rotate(20deg)'; var t = __renderDelta(); o.push(JSON.parse(__fastRenderCheck()).n, /rotate\\(20deg\\)/.test(t), /rgb\\(9, 0, 0\\)/.test(t)); a.style.transform = 'none'; __renderDelta(); a.style.transform = 'translate(50%, 0)'; __renderDelta(); a.textContent = 'z'; a.style.transform = 'rotate(1deg)'; t = __renderDelta(); o.push(JSON.parse(__fastRenderCheck()).n, /\"x\":\"z\"/.test(t), JSON.parse(__fastRenderCheck()).bad); o.join(',')"))
        this.check("only a transform or an opacity set: the kept render with the new value, the same as a whole render" (got == "8,11,11,true,true,11,true,0"))
    }
    fn controls:void () {
        def r:DomRealm (this.realm("<html><body style='margin:0;font:10px Arial'><input type=range id=r min=0 max=100 step=10 value=0><select id=m multiple style='font-size:10px;line-height:10px;border:0;padding:0'><option value=1>1<option value=2>2<option value=3>3<option value=4>4</select><div id=ce contenteditable style='font-size:10px'>abc</div><input id=t value=hello style='font-size:10px;padding:0;border:0'><input id=n type=number value=10 step=2><input id=d type=date value=2026-11-15><input id=tm type=time value=13:45><input id=c type=color value='#3366cc'><input id=f type=file></body></html>"))
        r.runScripts()
        def got (r.eval((this.file("tests/controls.js"))))
        this.check(("form controls by pointer and keys: pickers, range drag, list box, editing caret, file chooser (" + got + ")") (got == "i50 i100 c100,90,1,13,34,Xbc,true,2,12,true,2026-11-20,true,15:30,true,true,#000000,true,a.txt:2"))
    }
    fn focus:void () {
        def r:DomRealm (this.realm("<html><body style='margin:0;font:10px Arial'><a id=a href='#x'>a</a><div id=h><input id=lin></div><input id=t><div id=d></div><button id=last>last</button><dialog id=dlg><button id=d1>1</button><button id=d2>2</button></dialog></body></html>"))
        r.runScripts()
        def got (r.eval((this.file("tests/focus.js"))))
        this.check(("focus: Tab through shadow trees and slots, delegatesFocus, modal dialog, :focus-visible, UA ring, pointer leave, cursor (" + got + ")") (got == "a in1 lin t inner last,inner,inner,auto 1px,false,t:true,d1,d2 d1 d2,false:t,true:pointer,false:default"))
    }
    fn a11y:void () {
        def r:DomRealm (this.realm("<html><body><nav aria-label='Main'><a href='/a'>Home</a> <a>no href</a></nav><main><h1>Title <span aria-hidden=true>*</span></h1><h3 aria-level=4>Sub</h3><p>Some text</p><button>Save <img src='x.png' alt='disk'></button><button aria-label='Close'>x</button><button aria-pressed=true>Bold</button><label for=n>Name</label><input id=n value=Ann required><label><input type=checkbox checked> Agree</label><input type=range min=0 max=10 value=3 aria-label=Volume><select aria-label=Fruit><option>Apple<option selected>Pear</select><div role=tablist><div role=tab aria-selected=true tabindex=0>One</div><div role=tab aria-selected=false tabindex=-1>Two</div></div><div role=button aria-expanded=false aria-haspopup=menu tabindex=0>Menu</div><span id=lbl>Search box</span><input aria-labelledby=lbl placeholder=Find aria-describedby=hint><span id=hint hidden>type here</span><div hidden><button>gone</button></div><div style='display:none'><button>gone2</button></div><div aria-hidden=true><button>gone3</button></div><ul><li>One</li></ul><table><tr><th>H</th></tr><tr><td>C</td></tr></table></main></body></html>"))
        r.runScripts()
        def got (r.eval((this.file("tests/a11y.js"))))
        this.check(("a11y: roles, names and states from HTML and ARIA (" + got + ")") (got == "navigation:Main|link:Home|text:no href|main:|heading:Title:lv=1|heading:Sub:lv=4|paragraph:Some text|button:Save disk|img:disk|button:Close|button:Bold:pr=2|text:Name|textbox:Name:v=Ann,rq=1|text:Agree|checkbox:Agree:ck=2|slider:Volume:vn=3|combobox:Fruit:hp=listbox,v=Pear|option:Apple|option:Pear:se=2|tablist:|tab:One:se=2|tab:Two|button:Menu:ex=1,hp=menu|text:Search box|textbox:Search box:d=type here|list:|listitem:One|table:|rowgroup:|row:|columnheader:H|row:|cell:C"))
    }
    fn run:void () {
        this.plainDom()
        this.react()
        this.timers()
        this.form()
        this.errors()
        this.parser()
        this.shadow()
        this.keptStyles()
        this.adopted()
        this.hasAboveSubject()
        this.declarativeShadowPage()
        this.hasSibling()
        this.styleElement()
        this.scopedStyles()
        this.detachedImage()
        this.movedRender()
        this.controls()
        this.focus()
        this.a11y()
        print ("passed " + (to_string passes) + ", failed " + (to_string fails))
    }

    sfn main@(main):void () {
        def t (new RealmTest())
        if ((shell_arg_cnt) > 0) {
            t.dir = (shell_arg 0)
        }
        t.run()
    }
}
